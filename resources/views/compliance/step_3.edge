@section('content')
<div class="min-h-screen bg-slate-50 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-xl">
    
    <!-- Progress Indicator -->
    <div class="mb-8">
      <div class="flex items-center justify-between text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
        <span>Step 3 of 4</span>
        <span>Identity Verification</span>
      </div>
      <div class="w-full bg-slate-200 h-2 rounded-full overflow-hidden">
        <div class="bg-indigo-600 h-2 rounded-full transition-all duration-500" style="width: 75%;"></div>
      </div>
    </div>

    <!-- Header Card -->
    <div class="text-center mb-6">
      <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight">
        Verify Your Identity
      </h2>
      <p class="mt-2 text-sm text-slate-600 max-w">
        Please complete the quick identity check below. Make sure you have your government-issued ID ready.
      </p>
    </div>

    <!-- Main Container Card -->
    <div class="bg-white py-8 px-4 shadow-xl shadow-slate-200/50 rounded-2xl sm:px-10 border border-slate-100 relative overflow-hidden">
      
      <!-- State 1: Loader (Visible initially) -->
      <div id="sdk-loader" class="flex flex-col items-center justify-center py-16 space-y-4">
        <div class="relative w-12 h-12">
          <div class="w-12 h-12 rounded-full border-4 border-indigo-100 animate-spin border-t-indigo-600"></div>
        </div>
        <p class="text-sm font-medium text-slate-500 animate-pulse">Initializing secure verification portal...</p>
      </div>

      <!-- State 2: Error Container (Hidden by default) -->
      <div id="sdk-error" class="hidden py-8 text-center">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-red-100 text-red-600 mb-4">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900">Unable to load verification</h3>
        <p class="mt-2 text-sm text-slate-500">We couldn't set up the verification widget. Please refresh or try again later.</p>
        <button onclick="window.location.reload()" class="mt-6 inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 transition">
          Retry Verification
        </button>
      </div>

      <!-- State 3: Sumsub SDK Mounting Point -->
      <div id="sumsub-websdk-container" class="w-full"></div>

      <!-- State 4: Completion Notification (Hidden by default) -->
      <div id="completion-banner" class="hidden py-8 text-center space-y-4">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-emerald-100 text-emerald-600">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-slate-900">Verification Submitted!</h3>
        <p class="text-sm text-slate-600 max-w-sm mx-auto">
          Your documents are being reviewed. We are advancing you to the next step...
        </p>
      </div>

    </div>

    <!-- Security Footer -->
    <div class="mt-6 text-center flex items-center justify-center space-x-2 text-xs text-slate-400">
      <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 002-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
      </svg>
      <span>256-bit encrypted identity verification powered by Sumsub</span>
    </div>

  </div>
</div>

<!-- Sumsub WebSDK CDN -->
<script src="https://static.sumsub.com/idensic/static/sns-websdk-builder.js"></script>

<!-- Execution Script -->
<script>
  document.addEventListener('DOMContentLoaded', async () => {
    const loader = document.getElementById('sdk-loader');
    const errorContainer = document.getElementById('sdk-error');

    try {
      // 1. Request access token from backend
      const response = await fetch('/api/compliance/step-3/token', {
        method: 'GET',
        headers: {
          'Accept': 'application/json',
        }
      });

      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }

      const data = await response.json();

      if (!data.token) {
        throw new Error('No token returned from server');
      }

      // Hide loader once token is ready
      loader.classList.add('hidden');

      // 2. Launch WebSDK
      launchSumsubSDK(data.token);

    } catch (err) {
      console.error('Sumsub initialization failed:', err);
      loader.classList.add('hidden');
      errorContainer.classList.remove('hidden');
    }
  });

  function launchSumsubSDK(accessToken) {
    const snsWebSdkInstance = snsWebSdk.init(
      accessToken,
      // Refresh token handler if session expires (10 mins)
      () => fetch('/api/compliance/step-3/token')
              .then(res => res.json())
              .then(data => data.token)
    )
    .withConf({
      lang: 'en',
    })
    .on('sns:verbose', (data) => {
      console.log('[Sumsub SDK Event]:', data);
    })
    .on('sns:applicantStatus', (event) => {
      console.log('[Sumsub Status]:', event);

      // Trigger redirection or show completion when user submits or finishes
      if (event.reviewStatus === 'completed' || event.reviewResult?.reviewAnswer === 'GREEN') {
        const sdkContainer = document.getElementById('sumsub-websdk-container');
        const completionBanner = document.getElementById('completion-banner');

        sdkContainer.classList.add('hidden');
        completionBanner.classList.remove('hidden');

        // Give a 2-second delay before redirecting to step 4
        setTimeout(() => {
          window.location.href = '/compliance/step-4';
        }, 2000);
      }
    })
    .build();

    // Mount SDK inside our custom Tailwind container
    snsWebSdkInstance.launch('#sumsub-websdk-container');
  }
</script>
@end