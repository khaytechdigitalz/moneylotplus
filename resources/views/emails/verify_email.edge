<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body { font-family: Arial, sans-serif; background-color: #f4f4f5; padding: 20px; }
    .card { background: white; padding: 30px; border-radius: 8px; max-width: 500px; margin: 0 auto; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
    .btn { display: inline-block; padding: 12px 24px; background-color: #0070f3; color: white !important; text-decoration: none; border-radius: 5px; font-weight: bold; margin-top: 20px; }
    .footer { font-size: 12px; color: #71717a; margin-top: 30px; text-align: center; }
  </style>
</head>
<body>
  <div class="card">
    <h2>Welcome to Moneylot Plus, {{ name }}!</h2>
    <p>Thank you for signing up. Please click the button below to verify your email address and secure your account:</p>
    
    <a href="{{ url }}" class="btn">Verify Email Address</a>
    
    <p style="margin-top: 20px; font-size: 13px; color: #71717a;">
      If you did not request this email, you can safely ignore it. This link will expire in 24 hours.
    </p>
  </div>
  <div class="footer">
    &copy; 2026 Moneylot Plus. All rights reserved.
  </div>
</body>
</html>